{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "Debug",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"label": "Flash F4 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo loadfile stm32f4-debug/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device STM32F407VG -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
			],
			"options": { "cwd": "${workspaceFolder}/build" },
			"group": "build",
			"detail": "Flash STM32F4 (j-link)."
		},
		{
			"label": "1. Sign App for MCUboot",
			"type": "shell",
			"command": "python",
			"args": [
				"${workspaceFolder}/modules/mcuboot/scripts/imgtool.py",
				"sign",
				"--key", "modules/mcuboot/root-ec-p256.pem",
				"--header-size", "0x200",
				"--align", "4",
				"--slot-size", "0x40000",
				"--version", "1.0.0",
				"--pad-header",
				"test.bin",
				"build/signed_app.bin"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Подписывает test.bin и сохраняет как build/signed_app.bin"
		},
		{
			"label": "2. Flash Signed App (J-Link)",
			"type": "shell",
			"command": "JLink.exe",
			"args": [
				"-device", "STM32F407VG",
				"-if", "SWD",
				"-speed", "4000",
				"-NoGui", "1",
				"-CommandFile", "flash_app.jlink"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Прошивает signed_app.bin по адресу 0x08040000 через J-Link",
			"dependsOn": "1. Sign App for MCUboot"
		},

		{
			"label": "3. Sign App for MCUboot",
			"type": "shell",
			"command": "python",
			"args": [
				"${workspaceFolder}/modules/mcuboot/scripts/imgtool.py",
				"sign",
				"--key", "modules/mcuboot/root-ec-p256.pem",
				"--header-size", "0x200",
				"--align", "4",
				"--slot-size", "0x40000",
				"--version", "1.0.1",
				"--pad-header",
				"test2.bin",
				"build/signed_app2.bin"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Подписывает test2.bin и сохраняет как build/signed_app2.bin"
		},
		{
			"label": "4. Flash Signed App (J-Link)",
			"type": "shell",
			"command": "JLink.exe",
			"args": [
				"-device", "STM32F407VG",
				"-if", "SWD",
				"-speed", "4000",
				"-NoGui", "1",
				"-CommandFile", "flash_app2.jlink"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "Прошивает signed_app2.bin по адресу 0x08080000 через J-Link",
			"dependsOn": "3. Sign App for MCUboot"
		},

		{
			"label": "Erase F4 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo erase & echo q) > erase.jlink) && (JLink.exe -device STM32F407VG -if SWD -speed 4000 -NoGui 1 -CommandFile erase.jlink)"
			],
			"options": { "cwd": "${workspaceFolder}/build" },
			"group": "build",
			"detail": "Erase STM32F4 (j-link)."
		},
		{
			"label": "Flash F7 (j-link)",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/C",
				"((echo r & echo h & echo loadfile stm32f7-debug/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device STM32F746IG -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
			],
			"options": { "cwd": "${workspaceFolder}/build" },
			"group": "build",
			"detail": "Flash STM32F7 (j-link)."
		},
		{
			"label": "Run qemu-arm (gdb)",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",
				"-gdb", "tcp::1234", "-S",        
				"-kernel", "${command:cmake.launchTargetPath}"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
		{
			"label": "Run qemu-arm",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",     
				"-kernel", "${command:cmake.launchTargetPath}"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
	]
}
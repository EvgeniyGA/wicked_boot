{
	"version": "2.0.0",
	    "inputs": [
		{
            "id": "buildPreset",
            "type": "pickString",
            "description": "Выберите конфигурацию сборки (папку)",
            "options": [
                "stm32f4-debug",
                "stm32f7-debug"
            ],
            "default": "stm32f4-debug"
        },
        {
            "id": "targetDevice",
            "type": "pickString",
            "description": "Выберите целевой микроконтроллер",
            "options": [
                "STM32F407VG",
                "STM32F746NG"
            ],
            "default": "STM32F407VG"
        },
        {
            "id": "targetSlot",
            "type": "pickString",
            "description": "Choose slot",
            "options": [
                "slot1",
                "slot2"
            ],
            "default": "slot1"
        },
		{
			"id": "gdbMode",
			"type": "pickString",
			"description": "Режим запуска QEMU",
			"options": [
				"-gdb tcp::1234 -S",
				""
			],
			"default": ""
		}
    ],
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "Debug",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
            "label": "⚡ Flash (J-Link)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "((echo r & echo h & echo loadfile ${input:buildPreset}/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "detail": "Динамическая прошивка через J-Link (выбор пресета и MCU)",
            "problemMatcher": []
        },
        {
            "label": "⚡ Flash Signed App (J-Link) - (STM32F407 only)",
            "type": "shell",
            "command": "JLink.exe",
            "args": [
                "-device", "STM32F407VG",
                "-if", "SWD",
                "-speed", "4000",
                "-NoGui", "1",
                "-CommandFile", "samples/flash_app_${input:targetSlot}.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "detail": "Прошивает signed_app.bin в выбранный слот через J-Link",
            "problemMatcher": []
			//"dependsOn": "1. Sign App for MCUboot"
        },
        {
            "label": "🧹 Erase (J-Link)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "((echo r & echo h & echo erase & echo q) > erase.jlink) && (JLink.exe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile erase.jlink)"
            ],
            "options": { 
                "cwd": "${workspaceFolder}/build" 
            },
            "group": "build",
            "detail": "Полная очистка flash-памяти выбранного MCU через J-Link",
            "problemMatcher": []
        },
		{
			"label": "Run qemu-arm (gdb)",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",
				"-gdb", "tcp::1234", "-S",        
				"-kernel", "${command:cmake.launchTargetPath}",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu.bin,addr=0x08040000,force-raw=on",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu-nextv.bin,addr=0x08080000,force-raw=on"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
		{
			"label": "Run qemu-arm",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",     
				"-kernel", "${command:cmake.launchTargetPath}",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu.bin,addr=0x08040000,force-raw=on",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu-nextv.bin,addr=0x08080000,force-raw=on"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
		{
			"label": "🚀 Start J-Link Server (Remote Linux)",
			"type": "shell",
			"command": "ssh",
			"args": [
				"-t",
				"-L", "${config:localRttPort}:127.0.0.1:${config:remoteRttPort}",
				"${config:remoteJLinkUser}@${config:remoteJLinkHost}",
				"JLinkGDBServerCLExe",
				"-device", "${input:targetDevice}",
				"-if", "SWD",
				"-speed", "4000",
				"-nosinglerun",
				"-noLocalhostOnly",
				"-rtttelnetport", "${config:remoteRttPort}"
			],
			"problemMatcher": [],
			"isBackground": true,
			"presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false, "clear": true },
			"detail": "Starts JLinkGDBServer on remote machine (to stop juct close terminal)"
			// to stop manually: pkill -f JLinkGDBServerCLExe
		},
		{
			"label": "📡 Listen console rtt",
			"type": "shell",
			"command": "minicom",
			"args": [
				"-D",
				"tcp:localhost:${config:localRttPort}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"isBackground": true,
			"presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false, "clear": true },
			"detail": "Listen remote console via SSH tunnel"
		},
		{
			"label": "📡 Listen console uart",
			"type": "shell",
			"command": "minicom",
			"args": [
				"-D",
				"tcp:${config:remoteJLinkHost}:${config:localRttPort}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"isBackground": true,
			"presentation": { "reveal": "always", "panel": "dedicated", "showReuseMessage": false, "clear": true },
			"detail": "Listen remote console by running minicom",
		},
		{
			"label": "⚡ Flash Remote Main",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"scp ${command:cmake.launchTargetPath} ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/app.elf && scp ${workspaceFolder}/scripts/flash_elf_remote.jlink ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/flash.jlink && ssh ${config:remoteJLinkUser}@${config:remoteJLinkHost} \"JLinkExe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile /tmp/flash.jlink\""
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "flash ELF via JLinkExe",
			"problemMatcher": []
		},
		{
			"label": "⚡ Flash Remote Slot0",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"scp ${workspaceFolder}/samples/gas-lighter-fw_signed.bin ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/image0.bin && scp ${workspaceFolder}/scripts/flash_slot0_remote.jlink ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/flash_slot0.jlink && ssh ${config:remoteJLinkUser}@${config:remoteJLinkHost} \"JLinkExe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile /tmp/flash_slot0.jlink\""
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "flash ELF via JLinkExe",
			"problemMatcher": []
		},
		{
			"label": "⚡ Flash Remote Slot1",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"scp ${workspaceFolder}/samples/gas-lighter-fw_signed-nextv.bin ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/image1.bin && scp ${workspaceFolder}/scripts/flash_slot1_remote.jlink ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/flash_slot1.jlink && ssh ${config:remoteJLinkUser}@${config:remoteJLinkHost} \"JLinkExe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile /tmp/flash_slot1.jlink\""
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "flash ELF via JLinkExe",
			"problemMatcher": []
		},
		{
			"label": "⚡ Erase Remote",
			"type": "shell",
			"command": "sh",
			"args": [
				"-c",
				"scp ${workspaceFolder}/scripts/erase_remote.jlink ${config:remoteJLinkUser}@${config:remoteJLinkHost}:/tmp/erase_remote.jlink && ssh ${config:remoteJLinkUser}@${config:remoteJLinkHost} \"JLinkExe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile /tmp/erase.jlink\""
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"detail": "erase",
			"problemMatcher": []
		}
	]
}
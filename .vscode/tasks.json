{
	"version": "2.0.0",
	    "inputs": [
		{
            "id": "buildPreset",
            "type": "pickString",
            "description": "Выберите конфигурацию сборки (папку)",
            "options": [
                "stm32f4-debug",
                "stm32f7-debug"
            ],
            "default": "stm32f4-debug"
        },
        {
            "id": "targetDevice",
            "type": "pickString",
            "description": "Выберите целевой микроконтроллер",
            "options": [
                "STM32F407VG",
                "STM32F746NG"
            ],
            "default": "STM32F407VG"
        },
        {
            "id": "targetSlot",
            "type": "pickString",
            "description": "Choose slot",
            "options": [
                "slot1",
                "slot2"
            ],
            "default": "slot1"
        },
		{
			"id": "gdbMode",
			"type": "pickString",
			"description": "Режим запуска QEMU",
			"options": [
				"-gdb tcp::1234 -S",
				""
			],
			"default": ""
		}
    ],
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "Debug",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
            "label": "⚡ Flash (J-Link)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "((echo r & echo h & echo loadfile ${input:buildPreset}/${workspaceFolderBasename}.elf & echo q) > flash.jlink) && (JLink.exe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile flash.jlink)"
            ],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "detail": "Динамическая прошивка через J-Link (выбор пресета и MCU)",
            "problemMatcher": []
        },
        {
            "label": "⚡ Flash Signed App (J-Link) - (STM32F407 only)",
            "type": "shell",
            "command": "JLink.exe",
            "args": [
                "-device", "STM32F407VG",
                "-if", "SWD",
                "-speed", "4000",
                "-NoGui", "1",
                "-CommandFile", "samples/flash_app_${input:targetSlot}.jlink"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "detail": "Прошивает signed_app.bin в выбранный слот через J-Link",
            "problemMatcher": []
			//"dependsOn": "1. Sign App for MCUboot"
        },
        {
            "label": "🧹 Erase (J-Link)",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/C",
                "((echo r & echo h & echo erase & echo q) > erase.jlink) && (JLink.exe -device ${input:targetDevice} -if SWD -speed 4000 -NoGui 1 -CommandFile erase.jlink)"
            ],
            "options": { 
                "cwd": "${workspaceFolder}/build" 
            },
            "group": "build",
            "detail": "Полная очистка flash-памяти выбранного MCU через J-Link",
            "problemMatcher": []
        },
		{
			"label": "Run qemu-arm (gdb)",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",
				"-gdb", "tcp::1234", "-S",        
				"-kernel", "${command:cmake.launchTargetPath}",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu.bin,addr=0x08040000,force-raw=on",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu-nextv.bin,addr=0x08080000,force-raw=on"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
		{
			"label": "Run qemu-arm",
			"type": "shell",
			"command": "qemu-system-arm",
			"args": [
				"-M", "netduinoplus2",
				"-nographic", 
				"-serial", "mon:stdio",     
				"-kernel", "${command:cmake.launchTargetPath}",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu.bin,addr=0x08040000,force-raw=on",
				"-device", "loader,file=/home/dev/samples/gas-lighter-fw_signed_qemu-nextv.bin,addr=0x08080000,force-raw=on"
			],
			"isBackground": true,
			"problemMatcher": {
				"pattern": [ { "regexp": ".", "file": 1, "location": 2, "message": 3 } ],
				"background": { "activeOnStart": true, "beginsPattern": "^.*", "endsPattern": "^$"
				}
			}
		},
	]
}
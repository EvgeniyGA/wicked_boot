{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "inputs": [
        {
            "id": "mcuFamily",
            "type": "pickString",
            "description": "Выберите семейство MCU",
            "options": [
                "STM32F407VG",
                "STM32F7"
            ],
            "default": "STM32F407VG"
        }
    ],
    "configurations": [
        {
            "name": "Debug (J-Link)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:cmake.launchTargetPath}",
            "request": "launch",//attach
            "type": "cortex-debug",
            "servertype": "jlink",
            
            "interface": "swd",
            "device": "${input:mcuFamily}",
            "preRestartCommands": [ "load", "enable breakpoint", "monitor reset" ],
            "runToEntryPoint": "main",
            "liveWatch": { "enabled": true, "samplesPerSecond": 2 },
            
            "svdFile": "${workspaceFolder}/targets/${input:mcuFamily}/${input:mcuFamily}.svd",
            
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [ { "label": "RTT ${input:mcuFamily}", "port": 0, "type": "console" } ]
            }
        },
        {
            "name": "Debug (qemu)",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",    
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:1234",              
            "device": "STM32F407VG",        
            "runToEntryPoint" : "main",
            //"showDevDebugOutput" : "raw",
            "svdFile": "${workspaceFolder}/targets/stm32f4/STM32F407VG.svd",
            //"preLaunchTask": "Run qemu-arm (gdb)",
            "liveWatch": { "enabled": false, "samplesPerSecond": 2 },
        }
    ]
}
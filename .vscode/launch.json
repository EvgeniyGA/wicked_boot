{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name" : "Debug F4 (gdb/jlink)",
            "cwd" : "${workspaceRoot}",
            "executable": "${command:cmake.launchTargetPath}",     
            "interface": "swd",
            "request" : "launch",
            "type" : "cortex-debug",
            "servertype" : "jlink",
            "device": "STM32F407VG",
            "preRestartCommands" : [ "load", "enable breakpoint", "monitor reset" ],        
            "runToEntryPoint" : "main",        
            "svdFile": "${workspaceFolder}/targets/stm32f4/STM32F407.svd",
            "liveWatch": { "enabled": true, "samplesPerSecond": 2 },
            "rttConfig":
            {
                "enabled": true,
                "address": "auto",
                "decoders": [ { "label": "RTT F4", "port": 0, "type": "console" } ]
            }
        },
        {
            "name": "Attach F4 (gdb/jlink)",
            "cwd": "${workspaceRoot}",
            "executable": "${command:cmake.launchTargetPath}",     
            "interface": "swd",
            "request": "attach", 
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "STM32F407VG",
            
            "preRestartCommands": [ "enable breakpoint", "monitor reset" ],        
            
            "runToEntryPoint": "main",        
            "svdFile": "${workspaceFolder}/targets/stm32f4/STM32F407.svd",
            "liveWatch": { "enabled": true, "samplesPerSecond": 2 },
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "decoders": [ { "label": "RTT F4", "port": 0, "type": "console" } ]
            }
        },
        {
            "name": "Debug (qemu)",
            "cwd": "${workspaceFolder}",
            "executable": "${command:cmake.launchTargetPath}",    
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "external",
            "gdbTarget": "localhost:1234",              
            "device": "STM32F407VG",        
            "runToEntryPoint" : "main",
            //"showDevDebugOutput" : "raw",
            "svdFile": "${workspaceFolder}/targets/stm32f4/STM32F407.svd",
            //"preLaunchTask": "Run qemu-arm (gdb)",
            "liveWatch": { "enabled": false, "samplesPerSecond": 2 },
        }
    ]
}
{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/targets/stm32f4/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "TARGET": "stm32f4"
            }
        },
        {
            "name": "qemu-f4",
            "hidden": false,
            "inherits": "default",
            "toolchainFile": "${sourceDir}/targets/stm32f4/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "TARGET": "stm32f4",
                "CMAKE_BUILD_TYPE": "Debug",
                "FOR_QEMU": "OK"
            }
        },
        {
            "name": "stm32f4-default",
            "hidden": true,
            "inherits": "default",
            "toolchainFile": "${sourceDir}/targets/stm32f4/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "TARGET": "stm32f4"
            }
        },
        {
            "name": "stm32f7-default",
            "hidden": true,
            "inherits": "default",
            "toolchainFile": "${sourceDir}/targets/stm32f7/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
                "TARGET": "stm32f7"
            }
        },
        {
            "name": "stm32f4-debug",
            "inherits": "stm32f4-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "stm32f4-release",
            "inherits": "stm32f4-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "stm32f7-debug",
            "inherits": "stm32f7-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "stm32f7-release",
            "inherits": "stm32f7-default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "qemu-f4",
            "configurePreset": "qemu-f4"
        },
        {
            "name": "stm32f4-debug",
            "configurePreset": "stm32f4-debug"
        },
        {
            "name": "stm32f4-release",
            "configurePreset": "stm32f4-release"
        },
        {
            "name": "stm32f7-debug",
            "configurePreset": "stm32f7-debug"
        },
        {
            "name": "stm32f7-release",
            "configurePreset": "stm32f7-release"
        }
    ]
}